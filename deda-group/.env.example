# Copy to .env (never commit it) and export before running the collection scripts:
#   set -a; . ./.env; set +a
APIFY_API_KEY=your-apify-api-token-here
# Optional: page cap per domain for scripts/crawl.mjs (default 80)
MAX_PAGES=80
# Optional: path to a Playwright install for scripts/mobile-check.mjs
PLAYWRIGHT_PATH=playwright
